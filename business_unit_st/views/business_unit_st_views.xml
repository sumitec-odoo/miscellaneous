<?xml version="1.0"?>
<odoo>

    <record id="business_unit_st_view_form" model="ir.ui.view">
        <field name="name">business.unit.st.form.view</field>
        <field name="model">business.unit.st</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="active" invisible="1" />
                    <group>
                        <group>
                            <field name="id" invisible="1"/>
                            <field name="name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>    

    <record id="business_unit_st_view_tree" model="ir.ui.view">
        <field name="name">business.unit.st.list.view</field>
        <field name="model">business.unit.st</field>
        <field name="arch" type="xml">
            <list>
                <field name="id" column_invisible="True"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="business_unit_st_action" model="ir.actions.act_window">
        <field name="name">Unidades de Negocio</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">business.unit.st</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_business_unit_st"
        name="Unidades de Negocio"
        parent="base.menu_users"
        action="business_unit_st_action"
        sequence="100"/>

</odoo>
